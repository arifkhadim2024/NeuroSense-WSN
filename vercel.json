{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "web/**",
      "use": "@vercel/static"
    },
    {
      "src": "static_data/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/static_data/(.*)",
      "dest": "static_data/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "web/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "web/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "web/$1"
    }
  ]
}
